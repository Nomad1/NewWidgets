<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>NewWidgets</RootNamespace>
    <AssemblyName>NewWidgets</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TargetFrameworks>net472;net8.0</TargetFrameworks>
    <Configurations>Debug;Release</Configurations>
    <!-- Four projects in this folder emit an assembly called NewWidgets. Each one needs its
         own output and intermediate paths or they overwrite each other and the next build
         copies the wrong assembly. $(TargetFramework) is appended by the SDK. -->
    <OutputPath>bin\RunMobile\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\RunMobile\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;RUNMOBILE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DefineConstants>RUNMOBILE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Mac/MacController.cs" />
    <Compile Remove="Mac/MacSprite.cs" />
    <Compile Remove="WinForms/WinFormsController.cs" />
    <Compile Remove="WinForms/WinFormsSprite.cs" />
    <Compile Remove="Utility/MathHelper.cs" />
    <Compile Remove="Utility/SortedLinkedList.cs" />
    <Compile Remove="Utility/Transform.cs" />
    <Compile Remove="WinForms\WinFormsController.cs" />
    <Compile Remove="WinForms\WinFormsSprite.cs" />
    <Compile Remove="Mac\MacController.cs" />
    <Compile Remove="Mac\MacSprite.cs" />
    <Compile Remove="Utility\SortedLinkedList.cs" />
    <Compile Remove="Utility\Transform.cs" />
    <Compile Remove="Utility\MathHelper.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\RunMobile\RunMobile.Utility\RunMobile.Utility.csproj" />
  </ItemGroup>
</Project>